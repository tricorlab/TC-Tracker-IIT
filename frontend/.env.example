# ============================================================
# TC Tracker Frontend - Environment Variables Template
# ============================================================

# Backend API URL (Omit in local dev if using Vite proxy, or set explicitly)
VITE_API_BASE_URL=http://localhost:5000

# Google OAuth Client ID (Must match the one configured on backend)
VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
