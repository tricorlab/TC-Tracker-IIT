{
  "name": "tc-tracker-backend",
  "version": "1.0.0",
  "description": "TC Tracker Backend API with Express, TypeScript, and Google Sheets API",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/tests/*.test.ts",
    "db:init": "tsx src/scripts/initDatabase.ts"
  },
  "keywords": [
    "attendance",
    "leave-management",
    "express",
    "typescript",
    "google-sheets-api"
  ],
  "author": "TC Tracker Team",
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "google-auth-library": "^9.15.1",
    "googleapis": "^144.0.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
