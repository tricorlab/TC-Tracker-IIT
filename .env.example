# ============================================================
# TC TRACKER - ENVIRONMENT VARIABLES TEMPLATE (.env.example)
# Phase 3: Secure Google OAuth & Session Configuration
# ============================================================

# Backend Server Configuration
PORT=5000
FRONTEND_URL=http://localhost:5173

# Frontend API & Google Client Configuration
VITE_API_BASE_URL=http://localhost:5000
VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Session Security (Backend signing key for HTTP-only cookies)
SESSION_SECRET=your-random-32-character-session-secret

# Server-Side Password Pepper (Secret HMAC key for Google Sheets credential protection)
PASSWORD_PEPPER=your-random-32-character-secret-pepper-key

# Google OAuth 2.0 (User Authentication)
GOOGLE_OAUTH_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/google/callback

# Google Service Account (Backend Database Access to Google Sheets)
GOOGLE_SERVICE_ACCOUNT_EMAIL=tc-tracker-sa@your-project-id.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# Google Sheets Database ID
GOOGLE_SPREADSHEET_ID="your-google-spreadsheet-id"

# Google Drive Automated 6-Month Backup Folder ID (Optional)
GOOGLE_DRIVE_BACKUP_FOLDER_ID=your_google_drive_backup_folder_id

# ============================================================
# Email Notifications (Credentials, Leave Submissions, Alerts)
# ============================================================
# Option 1: Resend REST API (Recommended for Render / Cloud Hosting over HTTPS port 443)
# 1. Sign up for free (3,000 emails/mo) at https://resend.com
# 2. Generate an API Key (re_...) and enter below:
RESEND_API_KEY=re_123456789_abcdefg
EMAIL_FROM="TC Tracker <onboarding@resend.dev>"

# Option 2: Gmail SMTP with App Password (May time out on Render/Cloud due to port 465/587 blocks)
# 1. Enable 2-Step Verification: https://myaccount.google.com/security
# 2. Generate an App Password: https://myaccount.google.com/apppasswords
# 3. Enter your credentials below:
GMAIL_USER=your_sender_account@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Target Admin Gmail (Recipient of formal leave applications and system alerts)
ADMIN_GMAIL=admin_recipient@gmail.com
